# Copy to terraform.tfvars and fill real values.
# terraform.tfvars is gitignored.

aws_region   = "eu-north-1"
project_name = "grocerymate"
environment  = "dev"

ec2_key_name = "hello-world-key"
db_password  = "CHANGE_ME_use_strong_password"

# Optional overrides:
# asg_min     = 2
# asg_max     = 5
# asg_desired = 2

# Email for health alerts from Lambda (SNS subscription).
# Leave empty to skip. After apply, you must confirm the email.
# alert_email = "you@example.com"
